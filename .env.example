# Modelo do arquivo .env (copie para ".env" na raiz do projeto e preencha os valores).
# O .env é ignorado pelo Git: nunca commite senhas reais.
# É lido pelo docker-compose.yml e pelo Spring Boot (spring.config.import).

# Senha do usuário administrador (root) do MySQL.
MYSQL_ROOT_PASSWORD=

# Usuário e senha que a aplicação usa para acessar o banco busca_facil.
# O MySQL só cria esse usuário na PRIMEIRA vez que o volume é criado;
# se mudar depois, rode "docker compose down -v" (apaga os dados) e suba de novo.
DB_USER=
DB_PASSWORD=
